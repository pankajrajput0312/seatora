{
  "name": "seatora",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run db:snapshot && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:import": "node --experimental-strip-types prisma/import-mcc.ts",
    "db:snapshot": "node --experimental-strip-types prisma/snapshot.ts",
    "db:import-residents": "node --experimental-strip-types prisma/import-residents.ts",
    "ask:eval": "ASK_EVAL=1 vitest run src/features/ask/evals/run.test.ts",
    "ask:eval:replay": "ASK_EVAL=replay vitest run src/features/ask/evals/run.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^1.1.2",
    "@anthropic-ai/sdk": "^1.8.0",
    "@astryxdesign/core": "^0.7.16",
    "@astryxdesign/theme-neutral": "^0.7.16",
    "@hookform/resolvers": "^7.0.6",
    "@prisma/client": "^6.19.3",
    "@stylexjs/stylex": "^0.19.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "firebase": "^12.19.0",
    "geist": "^1.9.2",
    "lucide-react": "^1.72.0",
    "next": "15.5.29",
    "radix-ui": "^1.8.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.92.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.7.16",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "postcss": "^8.5.32"
  }
}
