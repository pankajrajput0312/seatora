// Core entities only. Remaining entities in docs/DATABASE_SCHEMA.md are added
// once their real data sources are understood.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SourceType {
  OFFICIAL
  VERIFIED_INSTITUTIONAL
  THIRD_PARTY_RESEARCH
  STUDENT_REPORTED
  UNVERIFIED_COMMUNITY
}

enum VerificationStatus {
  VERIFIED
  PENDING
  DISPUTED
  OUTDATED
}

enum TermKind {
  FEE
  STIPEND
  BOND
  PENALTY
}

model DataSource {
  id              String         @id @default(cuid())
  /// Stable import key, e.g. "mcc/2025/R1_final.pdf".
  key             String         @unique
  name            String
  url             String?
  type            SourceType
  counsellingYear Int?
  round           String?
  /// Provisional result; replaced by the final one for the same year and round.
  provisional     Boolean        @default(false)
  publishedAt     DateTime?
  createdAt       DateTime       @default(now())
  cutoffs         Cutoff[]
  announcements   Announcement[]
  colleges        College[]
  terms           CollegeTerm[]
  allotments      Allotment[]
  seatSource      SeatSource?
  meritList       MeritList?
}

model College {
  id                 String             @id @default(cuid())
  slug               String             @unique
  /// Stable import key from the MCC dataset: 40 name letters + "#" + PIN.
  key                String             @unique
  name               String
  /// Null when the source does not state it. Never guessed.
  city               String?
  state              String?
  pincode            String?
  /// Address as printed in the MCC allotment PDFs. Null when MCC printed only a short name.
  address            String?
  /// Every MCC institute id the seat PDFs print for the college (its MD/MS and DNB records can differ). Bundle schema 2; raw SQL like CollegeTerm.details.
  mccIds             String[]           @default([])
  /// The MCC institute profile of the college's main id; null without an id.
  mccProfileUrl      String?
  /// Institution type as the bundle infers it from name and quota (govt | private | trust | deemed | central | esic |
  /// municipal | armed_forces | psu | railway): not an official field, `typeBasis` says how. Null: not in the bundle.
  type               String?
  typeBasis          String?
  /// The website field of the college's own MCC profile, as declared ("www.…"); null when not one link.
  website            String?
  sourceId           String
  source             DataSource         @relation(fields: [sourceId], references: [id])
  lastVerifiedAt     DateTime?
  verificationStatus VerificationStatus @default(PENDING)
  specialties        CollegeSpecialty[]
  terms              CollegeTerm[]
  residents          Resident[]
  seatCounts         SeatCount[]
  prevAllotments     Allotment[]
  clinicalFacts      ClinicalFacts?
  feesStructured     FeesStructured[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([state])
}

model Specialty {
  id             String             @id @default(cuid())
  slug           String             @unique
  name           String
  degree         String // MD, MS, DNB, Diploma
  /// Canonical specialty code shared across degrees, e.g. "ANAESTHESIOLOGY" (MD and DNB Anaesthesiology). Set by the importer.
  code           String?
  colleges       CollegeSpecialty[]
  residents      Resident[]
  seatCounts     SeatCount[]
  prevAllotments Allotment[]
}

model CollegeSpecialty {
  id          String      @id @default(cuid())
  collegeId   String
  specialtyId String
  college     College     @relation(fields: [collegeId], references: [id])
  specialty   Specialty   @relation(fields: [specialtyId], references: [id])
  cutoffs     Cutoff[]
  allotments  Allotment[]
  seatCounts  SeatCount[]

  @@unique([collegeId, specialtyId])
  @@index([specialtyId])
}

/// Historical rank data. Never a prediction.
model Cutoff {
  id                 String             @id @default(cuid())
  collegeSpecialtyId String
  collegeSpecialty   CollegeSpecialty   @relation(fields: [collegeSpecialtyId], references: [id])
  counsellingYear    Int
  round              String // MCC: "R1", "R2", "R3", "stray", "special_stray"
  quota              String // MCC label verbatim, e.g. "All India", "DNB Quota", "Deemed/Paid Seats"
  category           String // seat category: "Open", "OBC", "SC", "ST", "EWS", "<X> PwD"
  openingRank        Int?
  closingRank        Int?
  /// Allotments made in this round (R2/R3/stray: new or upgraded only). Not the seat matrix.
  n                  Int
  sourceId           String
  source             DataSource         @relation(fields: [sourceId], references: [id])
  lastVerifiedAt     DateTime?
  verificationStatus VerificationStatus @default(PENDING)

  @@unique([collegeSpecialtyId, counsellingYear, round, quota, category])
  @@index([counsellingYear, category, closingRank])
  @@index([sourceId])
}

/// One seat allotment as printed in an MCC result PDF: rank and seat only, never a name or roll number.
model Allotment {
  id                 String           @id @default(cuid())
  collegeSpecialtyId String
  collegeSpecialty   CollegeSpecialty @relation(fields: [collegeSpecialtyId], references: [id])
  counsellingYear    Int
  round              String // as Cutoff.round
  /// NEET PG All India Rank.
  rank               Int
  quota              String // as Cutoff.quota
  category           String // seat category, as Cutoff.category
  status             String // "allotted" (R1, stray) | "fresh" | "upgraded" (R2, R3)
  sourceId           String
  source             DataSource       @relation(fields: [sourceId], references: [id])
  // Bundle schema 2 (null from a schema 1 bundle). Written and read with raw SQL (import-mcc.ts, server/queries.ts).
  /// The allotted candidate's own category as printed ("General", "OBC", … "<X> PwD"), not the seat category.
  candidateCategory  String?
  /// The candidate's choice number of the allotted seat (R2 / R3 PDFs only).
  optionNo           Int?
  /// R2 / R3: the seat the PDF prints in the previous round's columns (R1 for R2, R2 for R3); null where it prints "-".
  prevCollegeId      String?
  prevCollege        College?         @relation(fields: [prevCollegeId], references: [id])
  prevSpecialtyId    String?
  prevSpecialty      Specialty?       @relation(fields: [prevSpecialtyId], references: [id])
  prevQuota          String?
  /// The remark printed there: "reported" | "not_reported" | "seat_surrendered" | "seat_cancelled".
  prevRemark         String?

  @@index([counsellingYear, rank])
  @@index([collegeSpecialtyId, counsellingYear, round])
  @@index([sourceId])
}

/// One name on an MCC admitted-candidates list (PRIVATE bundle, `npm run db:import-residents`, replaced whole on import).
/// Name, course, year and list only: the source has no roll numbers or contact details, and none are stored.
model Resident {
  id          String    @id @default(cuid())
  /// Cascade: a college the MCC import removes takes its residents with it.
  collegeId   String
  college     College   @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  specialtyId String
  specialty   Specialty @relation(fields: [specialtyId], references: [id])
  /// Counselling year of the list.
  year        Int
  name        String
  /// All India Rank from that year's NBEMS NEET PG result (2023-2025); null when not known.
  rank        Int?
  /// The list as MCC labels it, e.g. "up to Round 3" or "final list (26 Mar 2025)".
  list        String
  /// The admitted-list PDF, e.g. "mcc/2025/admitted_upto_R3.pdf" (= DataSource.key).
  sourceKey   String
  /// Asked not to be shown: never rendered or returned by the API. Set from HiddenResident on every import.
  hidden      Boolean   @default(false)
  /// The NBEMS result the rank comes from, of the same year (DataSource.key, e.g. "nbems/2024/published_result.pdf");
  /// null without a rank.
  rankBasis   String?
  /// How the bundle matched rank + college + course to MCC's allotments: "matched" (exactly one row), "no_rank",
  /// "no_matching_allotment" or "ambiguous"; null from a bundle older than the match.
  match       String?
  /// The matched allotment's quota (as Allotment.quota, e.g. "All India") and round ("R1", "R2", "R3", "Stray",
  /// "Special stray"); only when match = "matched". Never a reservation category: not held.
  quota       String?
  round       String?

  @@index([collegeId, year])
  @@index([specialtyId])
  @@index([year, rank])
  /// Residents search (ILIKE '%token%'); pg_trgm, created by the migration (schema "extensions" on Supabase).
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Resident_name_trgm_idx")
  @@index([name, year(sort: Desc), id])
  @@index([hidden, year])
}

/// A person who asked not to be shown (the Residents tab "Hide"). Apart from Resident, which the imports replace or
/// cascade away, and with no foreign key, so a hide survives a new college key or course. By name and the college's PIN
/// code: a same-named person at another college with that PIN is hidden too (never the other way round).
model HiddenResident {
  name      String
  /// College.pincode, or College.key for a college without one.
  place     String
  createdAt DateTime @default(now())

  @@id([name, place])
}

/// Unused since plans (UsageDaily feature "residents" counts name reads now); kept so the deploy that adds plans can't
/// break the previous one mid-rollout. Drop in a later migration.
model ResidentsRead {
  userId String
  day    DateTime @db.Date
  count  Int      @default(0)

  @@id([userId, day])
}

/// A college key an MCC import retired (key_aliases.json: merged into another college or given a neutral label), kept
/// across imports so old institute links and saved option ids still reach the college. No foreign key: the import keeps
/// newKey current. Written and read with raw SQL (import-mcc.ts, server/catalog.ts), like CollegeTerm.details.
model RetiredCollegeKey {
  /// The retired College.key, or "sha256:<hex>" of it where the key held a person's name or e-mail (the bundle gives only the hash).
  oldKey    String   @id
  /// The college's slug when an import removed it, hashed the same way as oldKey; null when this database never had it.
  oldSlug   String?  @unique
  /// The College.key it is now; null when the college is no longer in the data.
  newKey    String?
  createdAt DateTime @default(now())
}

/// A college's self-reported clinical facts (bundle clinical_facts.ndjson): beds, OPD / IPD, equipment, per-course
/// accreditation and trainee record, disclosed stipend. `data` = the record without `key` and `nbems_disclosure`
/// (import-schema.ts mccClinicalFactsSchema): `values_meta` gives every value's source, period, check date and flags.
/// Replaced whole on import; raw SQL like CollegeTerm.details.
model ClinicalFacts {
  collegeId        String    @id
  college          College   @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  data             Json
  /// NBEMS mandatory disclosure on the hospital's site: "found" | "not_found" | "blocked" | "na".
  disclosureStatus String
  disclosureUrl    String?
  checkedAt        DateTime? @db.Date
}

/// Fee and stipend per course year, bond, leaving penalty and MCC forfeit per college × programme ("MD/MS", "Diploma",
/// "DNB", "NBEMS Diploma") × seat-type group (bundle fees_structured.ndjson; `quotaGroup` = its groups joined by "+",
/// e.g. "All India+DNB Quota"). `data` = the record without id, key, college, state, programme and seat groups
/// (import-schema.ts mccFeesStructuredSchema); `fee_display` "verbatim" (or absent) means its fee figures are never
/// shown, only `fee_text` (server/facts.ts). Replaced whole on import; raw SQL like CollegeTerm.details.
model FeesStructured {
  collegeId  String
  college    College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  programme  String
  quotaGroup String
  data       Json

  @@id([collegeId, programme, quotaGroup])
}

/// Fee, stipend, bond or penalty text exactly as published, per college and program (MD or DNB).
model CollegeTerm {
  id        String     @id @default(cuid())
  collegeId String
  college   College    @relation(fields: [collegeId], references: [id])
  program   String // "MD" | "DNB"
  kind      TermKind
  text      String
  /// FEE / STIPEND: the text's rupee figure when it has exactly one. BOND: what a non-service All India candidate pays for
  /// a PG degree (0 = no bond). PENALTY: the leaving penalty, else the forfeit.
  amountInr Int?
  /// BOND / PENALTY: the verified record (import-schema.ts bondDetailsSchema / penaltyDetailsSchema). Written and read with
  /// raw SQL (import-mcc.ts, server/catalog.ts), so a generated client without this field still works.
  details   Json?
  sourceId  String
  source    DataSource @relation(fields: [sourceId], references: [id])

  @@unique([collegeId, program, kind])
}

model Announcement {
  id              String     @id @default(cuid())
  title           String
  authority       String // e.g. "MCC", "DME Maharashtra"
  category        String // MCC import: notices.json kind verbatim, "notice" | "seat_matrix" | "result" | "schedule" | "bulletin"
  counsellingYear Int
  /// MCC: "R1", "R2", "R3", "stray"; null when the notice is not about one round.
  round           String?
  publishedAt     DateTime
  officialUrl     String?
  sourceId        String
  source          DataSource @relation(fields: [sourceId], references: [id])

  @@index([counsellingYear, authority])
}

/// One MCC seat list PDF of a round, as published (seat_sources.json). kind: "clear" = clear vacancy, "virtual" =
/// virtual vacancy, "new" = newly added seats. The kinds OVERLAP (a newly added seat is also in that round's clear
/// vacancy list): never add them together. A snapshot of its PDF: later MCC addition/removal notices are not applied.
/// Its DataSource has the URL, name and publishedAt (the date of the MCC notice linking it, else null) and keeps
/// `round` null, so the Decide catalog never counts the list as an allotment result.
model SeatSource {
  sourceId String      @id
  source   DataSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  year     Int
  round    String // as Cutoff.round
  kind     String // "clear" | "virtual" | "new"
  /// Σ seats of the list as the file gives it (the importer checks the rows add up to it).
  total    Int
  rows     SeatCount[]

  @@index([year, round, kind])
}

/// Seats one list prints for a college × course × quota × category. Lines the PDF prints twice stay two rows, so a
/// list's Σ seats equals the file's.
model SeatCount {
  id                 String            @id @default(cuid())
  seatSourceId       String
  seatSource         SeatSource        @relation(fields: [seatSourceId], references: [sourceId], onDelete: Cascade)
  collegeId          String
  college            College           @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  /// Null when the course is not in the MCC course list (courses.json).
  specialtyId        String?
  specialty          Specialty?        @relation(fields: [specialtyId], references: [id])
  /// Null when the course at this college has no allotment data (no Cutoff), i.e. no Decide option.
  collegeSpecialtyId String?
  collegeSpecialty   CollegeSpecialty? @relation(fields: [collegeSpecialtyId], references: [id])
  degree             String // as printed: "MD", "MS", "DNB", "NBEMS Diploma"...
  code               String // specialty code, as Specialty.code
  /// MCC label verbatim; null where the PDF has no quota column.
  quota              String?
  category           String // seat category, as Cutoff.category
  seats              Int

  @@index([seatSourceId, code])
  @@index([collegeSpecialtyId, seatSourceId])
  @@index([collegeId, seatSourceId])
}

/// One step of an MCC round (round_status.json), derived only from MCC notices, as of `asOf`.
model RoundStep {
  year          Int
  round         String // "R1" | "R2" | "R3" | "stray"
  step          String // "seat_matrix" | "choice_filling" | "provisional_result" | "final_result"
  status        String // "done" | "open" | "suspended" | "upcoming" | "unknown"
  /// Date of the notice behind the status (YYYY-MM-DD); null when implied or upcoming. Never guessed.
  date          String?
  /// The notice that justifies the status (or the schedule notice for an upcoming step).
  url           String?
  title         String?
  note          String?
  /// Dates printed in the official schedule notice at `url`, as printed (YYYY-MM-DD or ISO date-time in IST).
  scheduledFrom String?
  scheduledTo   String?
  scheduledOn   String?
  /// MCC's tentative schedule: may change.
  tentative     Boolean  @default(false)
  /// Every notice matched to this step, oldest first: [{ date, status, title, url }].
  events        Json
  asOf          DateTime

  @@id([year, round, step])
}

/// An NBEMS result PDF behind the score→rank and merit-position aggregates (score_rank.json, merit_position.json).
/// Aggregates only, no candidate rows. History, never a prediction.
model MeritList {
  sourceId   String          @id
  source     DataSource      @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  year       Int             @unique
  /// Total marks of that year's exam (2025: 800, 2026: 720): compare ranks across years, not scores.
  maxMarks   Int
  /// Candidates the PDF ranks.
  candidates Int
  /// Who the PDF covers, as the exporter states it (e.g. qualified AIQ-eligible candidates only).
  coverage   String
  /// The NBEMS notice that publishes the PDF (DataSource.url is the PDF).
  noticeUrl  String
  /// merit_position: AIQ ranks between rows; null when the PDF prints no category.
  step       Int?
  /// merit_position: qualified candidates per NBEMS category ({"ALL": n, "OBC": n, "OBC PwBD": n...}); null without categories.
  qualified  Json?
  scores     ScoreRank[]
  positions  MeritPosition[]
}

/// NEET PG rank range per score in one year's NBEMS result (best/worst = lowest/highest rank with that score).
model ScoreRank {
  year      Int
  score     Int
  bestRank  Int
  worstRank Int
  count     Int
  listId    String
  list      MeritList @relation(fields: [listId], references: [sourceId], onDelete: Cascade)

  @@id([year, score])
  @@index([year, bestRank])
}

/// One NBEMS AIQ merit-list threshold (every MeritList.step AIQ ranks): maxAir = highest NEET PG rank among candidates
/// at or ahead of AIQ rank `aiqRank`; count = candidates of `category` among them ("<cat> PwBD" also counted in <cat>).
model MeritPosition {
  year     Int
  aiqRank  Int
  maxAir   Int
  category String // NBEMS label verbatim: "ALL", "GENERAL", "GENERAL-EWS", "OBC", "SC", "ST", "<X> PwBD"
  count    Int
  listId   String
  list     MeritList @relation(fields: [listId], references: [sourceId], onDelete: Cascade)

  @@id([year, category, aiqRank])
  @@index([year, category, maxAir])
}

/// Early-access sign-ups from the landing page.
model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  examYear  Int
  createdAt DateTime @default(now())
}

/// Who an account is (features/plans/plans.ts): OWNER and ADMIN run the site (/decide/admin), PREMIUM holds the Season
/// Pass, FREE everyone else. The plan a user gets also depends on premiumUntil and FREE_FOR_ALL_UNTIL.
enum Role {
  OWNER
  ADMIN
  PREMIUM
  FREE
}

model User {
  id           String            @id @default(cuid())
  email        String            @unique
  name         String
  passwordHash String
  /// Consecutive failed sign-ins; the account is locked until lockedUntil after too many.
  failedLogins Int               @default(0)
  lockedUntil  DateTime?
  createdAt    DateTime          @default(now())
  role         Role              @default(FREE)
  /// Season Pass expiry: Premium limits until then, whatever the role.
  premiumUntil DateTime?
  /// How the account came to be, e.g. "signup", "admin"; free text.
  createdVia   String?
  /// Owner's notes on the account (the admin page).
  notes        String?
  sessions     Session[]
  passwordResets PasswordReset[]
  requests     FeatureRequest[]
  profile      UserProfile?
  choices      UserChoices?
  askLogs      AskLog[]
  askReports   AskReport[]
  askChats     AskConversation[]
  askPrefs     AskPreference[]
  payments     Payment[]         @relation("PaymentBuyer")
  /// Referrals (docs/REFERRALS.md). Set once, on her first view of /decide/refer; never changed by her.
  referralCode String?           @unique
  /// Who invited her (the /r/ link or ?ref= at sign-up). Never herself.
  referredById String?
  referredBy   User?             @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals    User[]            @relation("Referrals")
  /// UPI ID for referral payouts (name@bank).
  payoutUpi    String?
  refPayments  Payment[]         @relation("PaymentReferrer")
  earnings     ReferralEarning[]
  /// The device (seatora_aid cookie) and HMAC of the IP she signed up from (docs/FUNNEL.md): the per-device sign-up cap
  /// and the admin page's possible duplicates. Never the raw IP.
  signupAid    String?
  signupIpHash String?
  funnelEvents FunnelEvent[]
  couponRedemptions CouponRedemption[]

  @@index([referredById])
  @@index([signupAid])
  @@index([signupIpHash])
}

/// The Decide profile (features/decide/profile.ts profileSchema) of a signed-in user, so it follows the account across
/// devices (features/decide/components/account-sync.tsx). Signed out, it stays in localStorage only.
model UserProfile {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  json      Json
  /// Set by the save action; the client sends the one it last saw, so a stale device merges instead of overwriting.
  updatedAt DateTime
}

/// The Choices lists (features/decide/lib/choices.ts choicesSchema) of a signed-in user, synced like UserProfile.
model UserChoices {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  json      Json
  updatedAt DateTime
}

/// Login sessions. Only a SHA-256 hash of the cookie token is stored.
model Session {
  id        String   @id // sha256(token)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  /// The device (seatora_aid) and HMAC of the IP it was opened from (docs/FUNNEL.md).
  aid       String?
  ipHash    String?

  @@index([userId])
}

/// Counted uses per account per IST day and feature (features/plans/usage.ts checkAndCount): "ask", "residents".
/// One atomic upsert per use; no foreign key (counters only).
model UsageDaily {
  userId  String
  /// The day in India (Asia/Kolkata): limits reset at 00:00 IST.
  day     DateTime @db.Date
  feature String
  count   Int      @default(0)

  @@id([userId, day, feature])
}

/// Distinct things an account opened per IST day (feature "institutes": key = College.key). Insert-ignore, then count.
model UsageDistinct {
  userId  String
  day     DateTime @db.Date
  feature String
  key     String

  @@id([userId, day, feature, key])
}

/// What an owner or admin changed on an account (/decide/admin): who, whom, and the fields before and after.
/// A one-time password reset link, made on the admin page (there is no email provider): the DB only sees the token's
/// hash. An hour long; used, or a newer link made, it is deleted (src/features/auth/lib/reset.ts).
model PasswordReset {
  id        String   @id // sha256(token)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model AdminAudit {
  id        String   @id @default(cuid())
  actorId   String
  targetId  String
  action    String
  before    Json
  after     Json
  createdAt DateTime @default(now())

  @@index([targetId, createdAt])
}

/// "Request a feature" (src/features/requests): a feature, a customization, a data correction or anything else. Plain text,
/// read by the owner (SEATORA_OWNER_EMAILS). kind and status are the lists in src/features/requests/validations.ts.
model FeatureRequest {
  id        String   @id @default(cuid())
  kind      String
  message   String
  /// Where to reply: the signed-in user's email by default, required from anyone signed out.
  email     String?
  /// SetNull: deleting an account keeps its requests, unlinked.
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Where it was sent from, e.g. "/decide/options".
  page      String?
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([userId])
}

/// Ask Seatora (src/features/ask, owner only): one row per question, written when it starts (the hourly request limit
/// counts these) and finished with its usage. Token counts, tool names, latency and outcome only: never message text or names.
model AskLog {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  model            String
  effort           String
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  tools            String[]
  rounds           Int      @default(0)
  latencyMs        Int      @default(0)
  /// started, ok, refusal, max_tokens, partial (time ran out: best answer so far), aborted, rate_limited, error, replayed
  outcome          String   @default("started")
  conversationId   String?
  /// The answer check (features/ask/check.ts): numbers and links found in this turn's sources, and those not found.
  checkPassed      Int      @default(0)
  checkFailed      Int      @default(0)
  /// The model was asked once to correct the answer because the check failed.
  corrected        Boolean  @default(false)
  /// Elapsed ms per phase: { modelMs, toolMs, checkMs, firstTextMs }.
  timing           Json?

  @@index([userId, createdAt])
}

/// A plan report the assistant wrote (create_report), shown at /decide/ask/report/<id> to the account that made it.
model AskReport {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  /// { profile, sections: [{ heading, body (markdown) }], choices: [...], sources: [...] } (features/ask/reports.ts)
  json      Json
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// An Ask Seatora chat (owner only): her questions and the answers, so a reload or a dropped connection shows the
/// finished answer and she can reopen past chats. Deleted after 30 days without activity (features/ask/memory.ts).
model AskConversation {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  messages  AskMessage[]

  @@index([userId, updatedAt])
}

/// One turn's question (role user) or answer (role assistant). `requestId` (the browser's id for the turn) makes a
/// retried request idempotent. Answer status: streaming (being written, saved every few seconds), done, partial, error, stopped.
model AskMessage {
  id             String          @id @default(cuid())
  conversationId String
  conversation   AskConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  requestId      String
  role           String
  content        String          @default("")
  /// Deep analysis: the model's summarised reasoning ("How I reasoned").
  thinking       String?
  /// streaming, checkpoint (between two runs: the browser starts the next), done, partial, error, stopped
  status         String          @default("done")
  /// The answer's runs so far (0 = the first); a continue names the run it starts, so a repeat is a no-op.
  segment        Int             @default(0)
  /// Where the run stood after its last finished round (agent.ts Checkpoint): the next run resumes it.
  checkpoint     Json?
  /// What it is doing now ("Checking closing ranks…"), for a browser reading the saved turn.
  phase          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([conversationId, requestId, role])
  @@index([conversationId, createdAt])
}

/// What she asked Ask Seatora to remember (course priority, budget, bond tolerance, states…): one row per key, shown and
/// editable in "What Seatora remembers".
model AskPreference {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  value     String
  updatedAt DateTime @updatedAt

  @@id([userId, key])
}

/// A Razorpay checkout (features/payments). The amount comes from PLANS on the server, never from the browser. The
/// order's receipt is this id. status: created, paid (verified signature or webhook; paidAt set), failed.
model Payment {
  id                String           @id
  userId            String
  user              User             @relation("PaymentBuyer", fields: [userId], references: [id], onDelete: Cascade)
  plan              String
  /// In paise: what she pays (listAmount - discount).
  amount            Int
  /// The plan's price before any discount, paise.
  listAmount        Int
  /// The referral discount, paise (0 without one).
  discount          Int              @default(0)
  /// Whose invite gave the discount; earns them a ReferralEarning when paid.
  referrerId        String?
  referrer          User?            @relation("PaymentReferrer", fields: [referrerId], references: [id], onDelete: SetNull)
  /// The coupon that gave the discount (no referral then). A 100% coupon's row is paid at once, with no Razorpay order.
  couponId          String?
  coupon            Coupon?          @relation(fields: [couponId], references: [id], onDelete: SetNull)
  redemption        CouponRedemption?
  currency          String
  /// Null only for a free (100% coupon) row (a CHECK).
  razorpayOrderId   String?          @unique
  razorpayPaymentId String?          @unique
  status            String           @default("created")
  createdAt         DateTime         @default(now())
  paidAt            DateTime?
  referralEarning   ReferralEarning?

  @@index([userId])
  @@index([referrerId])
}

/// 20% of a referred friend's payment, owed to the referrer (docs/REFERRALS.md). Created with the payment's paid mark.
model ReferralEarning {
  id         String    @id @default(cuid())
  referrerId String
  referrer   User      @relation(fields: [referrerId], references: [id], onDelete: Cascade)
  paymentId  String    @unique
  payment    Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  buyerId    String
  /// Paise.
  amount     Int
  /// pending, paid_out or void (a CHECK constraint).
  status     String    @default("pending")
  createdAt  DateTime  @default(now())
  paidOutAt  DateTime?
  note       String?

  @@index([referrerId])
}

/// First-party funnel events (docs/FUNNEL.md, features/funnel): the name (lib.ts EVENTS), the device and/or account,
/// where an Upgrade was clicked, and small non-personal meta. Kept 12 months.
model FunnelEvent {
  id        BigInt   @id @default(autoincrement())
  at        DateTime @default(now())
  name      String
  aid       String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  placement String?
  meta      Json     @default("{}")

  @@index([name, at])
  @@index([userId])
  @@index([aid])
}

/// Server and browser errors grouped by fingerprint (sha1 of kind, route and the message without numbers or ids). No
/// request bodies, query strings, emails or names (docs/FUNNEL.md "Errors").
model ErrorGroup {
  fingerprint String    @id
  kind        String
  message     String
  route       String
  count       Int       @default(1)
  firstAt     DateTime  @default(now())
  lastAt      DateTime  @default(now())
  lastDigest  String?
  /// Set from the admin page; a new occurrence clears it (reopens).
  resolvedAt  DateTime?
}

/// A Season Pass coupon (docs/PAYMENTS.md "Coupons"), made on /decide/admin. 100% off: free, with no Razorpay payment.
model Coupon {
  id           String             @id @default(cuid())
  /// A–Z and 0–9, 3–20 characters (a CHECK).
  code         String             @unique
  /// 1–100 (a CHECK).
  percentOff   Int
  active       Boolean            @default(true)
  /// Null: no limit.
  maxUses      Int?
  uses         Int                @default(0)
  /// Only this account may use it (lowercase, a CHECK); null: anyone.
  allowedEmail String?
  validUntil   DateTime?
  note         String?
  createdAt    DateTime           @default(now())
  redemptions  CouponRedemption[]
  payments     Payment[]
}

/// One account's use of a coupon (once each), made when its payment is paid.
model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentId String?  @unique
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@unique([couponId, userId])
  @@index([userId])
}
