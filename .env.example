# PostgreSQL connection. Only needed for db:* scripts and pages that query the database.
DATABASE_URL="postgresql://seatora:seatora@localhost:5432/seatora?schema=public"
NEXT_PUBLIC_SITE_URL="https://your-domain.in"
NEXT_PUBLIC_CONTACT_EMAIL="privacy@your-domain.in"
# Access gate (src/middleware.ts): /decide and /api/v1 need a signed-in account on SEATORA_ALLOWED_EMAILS.
# Signs the seatora_access cookie; at least 32 random characters, nobody types it. Generate with: openssl rand -hex 32
# Changing it signs everyone out of Decide (they sign in again).
SITE_ACCESS_SECRET=""
# Comma-separated emails that may sign up and sign in (case and spaces don't matter). Changing it voids every access cookie.
# Production needs both: without them /decide and /api/v1 are always denied. Unset both in development to leave them open
# (names stay hidden); setting only one, or a short secret, denies them there too.
SEATORA_ALLOWED_EMAILS=""
# Sign-up also needs this code (there is no email verification). 16+ characters, given to the invitee out of band.
# Generate with: openssl rand -hex 8. Unset it once the account exists: unset or short means sign-up is closed.
SEATORA_INVITE_CODE=""
# Who reads and triages "Request a feature" submissions (src/features/requests): comma-separated, signed in and on
# SEATORA_ALLOWED_EMAILS too. Empty: nobody. Owner = every buyer's requests and emails: set only an address whose account
# the owner already created themselves (check the User row as in RUNBOOK 3), never one with no account while
# SEATORA_INVITE_CODE is set (nothing verifies sign-up emails, so whoever has the code could claim it).
SEATORA_OWNER_EMAILS=""
